# MoneyOS Cloud v0.1
# Copy to .env.local for local development or add in Vercel Project Settings.

# Supabase cloud database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI provider. We start provider-independent.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Safety controls
MONEYOS_DEFAULT_AUTO_APPROVAL_LEVEL=1
MONEYOS_DAILY_AI_BUDGET_USD=1
MONEYOS_MONTHLY_AI_BUDGET_USD=20

# Agent AI configuration
# Providers supported now: openrouter, openai, groq, gemini, fallback
MONEYOS_DEFAULT_AI_PROVIDER=openrouter
MONEYOS_DEFAULT_AI_MODEL=openai/gpt-4o-mini

# Shared provider keys. Use one shared key, or override per agent below.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Optional per-agent overrides
MONEYOS_GOVERNOR_PROVIDER=openrouter
MONEYOS_GOVERNOR_MODEL=openai/gpt-4o-mini
MONEYOS_GOVERNOR_API_KEY=
MONEYOS_CEO_PROVIDER=openrouter
MONEYOS_CEO_MODEL=openai/gpt-4o-mini
MONEYOS_CEO_API_KEY=
MONEYOS_RESEARCH_PROVIDER=openrouter
MONEYOS_RESEARCH_MODEL=openai/gpt-4o-mini
MONEYOS_RESEARCH_API_KEY=
MONEYOS_BUILDER_PROVIDER=openrouter
MONEYOS_BUILDER_MODEL=openai/gpt-4o-mini
MONEYOS_BUILDER_API_KEY=
MONEYOS_BUSINESS_PROVIDER=openrouter
MONEYOS_BUSINESS_MODEL=openai/gpt-4o-mini
MONEYOS_BUSINESS_API_KEY=
MONEYOS_ANALYTICS_PROVIDER=openrouter
MONEYOS_ANALYTICS_MODEL=openai/gpt-4o-mini
MONEYOS_ANALYTICS_API_KEY=
MONEYOS_QA_PROVIDER=openrouter
MONEYOS_QA_MODEL=openai/gpt-4o-mini
MONEYOS_QA_API_KEY=
MONEYOS_FINANCE_PROVIDER=openrouter
MONEYOS_FINANCE_MODEL=openai/gpt-4o-mini
MONEYOS_FINANCE_API_KEY=
MONEYOS_SECURITY_PROVIDER=openrouter
MONEYOS_SECURITY_MODEL=openai/gpt-4o-mini
MONEYOS_SECURITY_API_KEY=

# Vercel / automation
CRON_SECRET=
MONEYOS_AUTOMATION_MISSION=Generate legitimate revenue across ethical niches using low-cost software, services, automations, or digital products.
